#!/bin/bash
#
# Convert FILE to FILE.png
# (Generated by Gemini)

# Check if at least one argument is provided
if [ "$#" -eq 0 ]; then
    echo "Usage: to-png <file1> [file2 ...]"
    exit 1
fi

# Loop through all provided arguments
for file in "$@"; do
    # Check if the input is a valid file
    if [ ! -f "$file" ]; then
        echo "Warning: File '$file' not found. Skipping."
        continue
    fi

    echo "Converting '$file' to '${file}.png'..."

    # Convert using ImageMagick's convert tool
    convert "$file" "${file}.png"

    # Check if the convert command succeeded
    if [ $? -eq 0 ]; then
        echo "✅ Successfully created '${file}.png'"
    else
        echo "❌ Error converting '$file'"
    fi
    echo "----------------------------------------"
done
