#!/bin/zsh
#
# Convert FILE to FILE.mp3
# (Generated by Gemini)

# Check if at least one argument is provided
if [ "$#" -eq 0 ]; then
    echo "Usage: to-mp3 <file1> [file2 ...]"
    exit 1
fi

# Loop through all provided arguments
for file in "$@"; do
    # Check if the input is a valid file
    if [ ! -f "$file" ]; then
        echo "Warning: File '$file' not found. Skipping."
        continue
    fi

    echo "Converting '$file' to '${file}.mp3'..."

    # Convert using ffmpeg
    # -v quiet -stats: Keeps the output clean while showing progress
    # -y: Overwrites output file if it already exists
    # -vn: Strips video streams (useful if converting from mp4/mkv)
    ffmpeg -v quiet -stats -y -i "${file:A}" -vn "${file:A}.mp3"
    # NOTE: must resolve to absolute path so that ffmpeg doesn't treat filename as protocol

    # Check if the ffmpeg command succeeded
    if [ $? -eq 0 ]; then
        echo "✅ Successfully created '${file}.mp3'"
    else
        echo "❌ Error converting '${file}'"
    fi
    echo "----------------------------------------"
done
